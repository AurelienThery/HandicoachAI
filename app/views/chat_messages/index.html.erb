<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm" style="height: 80vh;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h4 class="mb-0">💬 Chat avec HandIaCoach</h4>
          <small>Assistant IA</small>
        </div>
        
        <div class="card-body overflow-auto" id="messages" style="height: calc(80vh - 140px);"
             data-controller="chat" data-chat-user-id-value="<%= current_user.id %>">
          <%= turbo_stream_from "chat_#{current_user.id}" %>
          
          <% if @messages.empty? %>
            <div class="text-center py-5">
              <div class="display-4 mb-3">🤖</div>
              <h5>Bienvenue sur HandIaCoach !</h5>
              <p class="text-muted">
                Je suis votre assistant IA spécialisé dans la création de routines visuelles 
                pour les personnes en situation de handicap.
              </p>
              <p class="text-muted">
                Posez-moi vos questions ou demandez-moi de créer une routine !
              </p>
              <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <button type="button" class="btn btn-outline-primary btn-sm quick-message" 
                        data-message="Bonjour, comment peux-tu m'aider ?">
                  👋 Bonjour
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm quick-message"
                        data-message="Je voudrais créer une routine du matin">
                  🌅 Routine du matin
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm quick-message"
                        data-message="Comment structurer une routine pour un enfant TSA ?">
                  🧩 Conseil TSA
                </button>
              </div>
            </div>
          <% else %>
            <% @messages.each do |message| %>
              <%= render "chat_messages/message", message: message %>
            <% end %>
          <% end %>
        </div>
        
        <div class="card-footer">
          <%= form_with model: ChatMessage.new, url: chat_messages_path, 
              id: "message_form", class: "d-flex gap-2" do |f| %>
            <%= f.text_field :content, class: "form-control", 
                placeholder: "Écrivez votre message...", 
                autocomplete: "off",
                id: "message_content" %>
            <%= f.submit "Envoyer", class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Auto-scroll to bottom
    const messages = document.getElementById('messages');
    if (messages) {
      messages.scrollTop = messages.scrollHeight;
    }
    
    // Quick message buttons
    document.querySelectorAll('.quick-message').forEach(button => {
      button.addEventListener('click', function() {
        const input = document.getElementById('message_content');
        if (input) {
          input.value = this.dataset.message;
          input.form.requestSubmit();
        }
      });
    });
  });
</script>
