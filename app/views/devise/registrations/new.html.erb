<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header text-center bg-primary text-white">
          <h2 class="mb-0">🧩 Créer un compte</h2>
        </div>
        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :name, "Nom", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "Votre nom" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "votre@email.com" %>
            </div>

            <div class="mb-3">
              <%= f.label :role, "Je suis", class: "form-label" %>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <%= f.radio_button :role, "family", class: "form-check-input", id: "role_family", checked: true %>
                  <label class="form-check-label" for="role_family">
                    👨‍👩‍👧 Famille / Aidant
                  </label>
                </div>
                <div class="form-check">
                  <%= f.radio_button :role, "professional", class: "form-check-input", id: "role_professional" %>
                  <label class="form-check-label" for="role_professional">
                    👩‍⚕️ Professionnel
                  </label>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Mot de passe", class: "form-label" %>
              <% if @minimum_password_length %>
                <small class="text-muted">(<%= @minimum_password_length %> caractères minimum)</small>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= f.submit "Créer mon compte", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
        <div class="card-footer text-center">
          <p class="mb-0">Déjà inscrit ? <%= link_to "Se connecter", new_session_path(resource_name) %></p>
        </div>
      </div>
    </div>
  </div>
</div>
