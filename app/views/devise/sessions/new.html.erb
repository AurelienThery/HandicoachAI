<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header text-center bg-primary text-white">
          <h2 class="mb-0">🧩 Connexion</h2>
        </div>
        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "votre@email.com" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Mot de passe", class: "form-label" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, "Se souvenir de moi", class: "form-check-label" %>
              </div>
            <% end %>

            <div class="d-grid mb-3">
              <%= f.submit "Se connecter", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>

          <div class="text-center">
            <%= link_to "Mot de passe oublié ?", new_password_path(resource_name) %>
          </div>
        </div>
        <div class="card-footer text-center">
          <p class="mb-0">Pas encore inscrit ? <%= link_to "Créer un compte", new_registration_path(resource_name) %></p>
        </div>
      </div>
    </div>
  </div>
</div>
