<div class="container py-4">
  <div class="row mb-4">
    <div class="col">
      <h1>Tableau de bord</h1>
      <p class="text-muted">Bienvenue, <%= current_user.name || current_user.email.split('@').first %> !</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Quick Stats -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="display-6 me-3">📋</div>
            <div>
              <h5 class="card-title mb-0">Mes Routines</h5>
              <p class="text-muted mb-0"><%= @routines.size %> routine(s)</p>
            </div>
          </div>
          <%= link_to "Voir mes routines", routines_path, class: "btn btn-outline-primary w-100" %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="display-6 me-3">💬</div>
            <div>
              <h5 class="card-title mb-0">Chat IA</h5>
              <p class="text-muted mb-0">Assistant disponible</p>
            </div>
          </div>
          <%= link_to "Discuter avec l'IA", chat_messages_path, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center mb-3">
            <div class="display-6 me-3">⭐</div>
            <div>
              <h5 class="card-title mb-0">Mon Abonnement</h5>
              <p class="text-muted mb-0">
                Plan <%= current_user.subscription_plan.capitalize %>
                <% if current_user.pro_plan? %>
                  <span class="badge bg-warning text-dark">Pro</span>
                <% end %>
              </p>
            </div>
          </div>
          <%= link_to "Gérer", subscriptions_path, class: "btn btn-outline-secondary w-100" %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Routines -->
  <div class="row mt-5">
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Routines récentes</h4>
        <%= link_to "Nouvelle routine", new_routine_path, class: "btn btn-sm btn-primary" %>
      </div>

      <% if @routines.any? %>
        <div class="list-group">
          <% @routines.first(5).each do |routine| %>
            <%= link_to routine_path(routine), class: "list-group-item list-group-item-action" do %>
              <div class="d-flex w-100 justify-content-between">
                <h5 class="mb-1"><%= routine.title %></h5>
                <small class="text-muted">
                  <% if routine.visibility == "shared" %>
                    🔗 Partagée
                  <% else %>
                    🔒 Privée
                  <% end %>
                </small>
              </div>
              <p class="mb-1 text-muted"><%= truncate(routine.description, length: 100) %></p>
              <small class="text-muted">
                <%= routine.steps_array.size %> étape(s) • 
                Créée le <%= routine.created_at.strftime("%d/%m/%Y") %>
              </small>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card border-0 bg-light">
          <div class="card-body text-center py-5">
            <div class="display-4 mb-3">📋</div>
            <h5>Aucune routine pour l'instant</h5>
            <p class="text-muted">Créez votre première routine avec l'aide de l'IA.</p>
            <%= link_to "Créer une routine", new_routine_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Quick Chat -->
    <div class="col-lg-4">
      <h4 class="mb-3">Aide rapide</h4>
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <p class="text-muted mb-3">Besoin d'aide pour créer une routine ?</p>
          <div class="d-grid gap-2">
            <%= link_to chat_messages_path, class: "btn btn-outline-primary text-start" do %>
              💬 Demander à l'IA
            <% end %>
            <%= link_to new_routine_path, class: "btn btn-outline-secondary text-start" do %>
              ➕ Nouvelle routine
            <% end %>
          </div>
        </div>
      </div>

      <% if current_user.basic_plan? %>
        <div class="card border-warning mt-4">
          <div class="card-body">
            <h6 class="card-title">🌟 Passez au Pro</h6>
            <p class="card-text small text-muted">
              Routines illimitées, partage avancé, et plus encore !
            </p>
            <%= link_to "Voir les avantages", pricing_subscriptions_path, class: "btn btn-warning btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
